# Copy to /etc/puzzle-table.env and make it readable only by root:
#   sudo install -m 600 puzzle-table.env.example /etc/puzzle-table.env

# The family passcode. Changing it signs everyone out.
PUZZLE_PASSCODE=change-me-to-something-long

# Listen only on localhost; the web server in front of it handles HTTPS.
PUZZLE_ADDR=127.0.0.1:8080

# Photos, progress and the sign-in key live here. Back this folder up.
PUZZLE_DATA=/var/lib/puzzle-table

# Names (comma-separated) who may remove anyone's photos.
PUZZLE_ADMINS=
